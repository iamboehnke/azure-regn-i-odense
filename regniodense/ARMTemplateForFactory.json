{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "regniodense"
		},
		"ls_adls_regn_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://regniodense.dfs.core.windows.net/"
		},
		"ls_dmi_rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://opendataapi.dmi.dk"
		},
		"ls_sql_regn_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "regniodense.database.windows.net"
		},
		"ls_sql_regn_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "regniodense-free-sql-db-3139183"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_from_ts": {
			"type": "string",
			"defaultValue": "@concat(formatDateTime(addDays(trigger().scheduledTime, -1), 'yyyy-MM-dd'), 'T00:00:00Z')"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_to_ts": {
			"type": "string",
			"defaultValue": "@concat(formatDateTime(trigger().scheduledTime, 'yyyy-MM-dd'), 'T00:00:00Z')"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_station_ids": {
			"type": "array",
			"defaultValue": [
				"05406",
				"05408",
				"06126"
			]
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_dmi_precip_bronze')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEachFunction",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.station_ids",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "copy_data_function",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"supportRFC5988": "true"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_dmi_metobs",
											"type": "DatasetReference",
											"parameters": {
												"from_ts": {
													"value": "@pipeline().parameters.from_ts",
													"type": "Expression"
												},
												"to_ts": {
													"value": "@pipeline().parameters.to_ts",
													"type": "Expression"
												},
												"station_id": "@item()"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_bronze_json",
											"type": "DatasetReference",
											"parameters": {
												"station_id": "@item()",
												"from_ts": {
													"value": "@pipeline().parameters.from_ts",
													"type": "Expression"
												},
												"to_ts": {
													"value": "@pipeline().parameters.to_ts",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"from_ts": {
						"type": "string"
					},
					"to_ts": {
						"type": "string"
					},
					"station_ids": {
						"type": "array",
						"defaultValue": [
							"05406",
							"06120",
							"06126"
						]
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_dmi_metobs')]",
				"[concat(variables('factoryId'), '/datasets/ds_bronze_json')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_export_to_sql')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_gold_to_sql",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "upsert",
								"upsertSettings": {
									"useTempDB": true,
									"keys": [
										"station_id",
										"hour_start"
									]
								},
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "station_id",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "station_id",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "hour_start",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "hour_start",
											"type": "DateTime",
											"physicalType": "datetime2"
										}
									},
									{
										"source": {
											"name": "precip_mm",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "precip_mm",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 6
										}
									},
									{
										"source": {
											"name": "max_30min_mm",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "max_30min_mm",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 6
										}
									},
									{
										"source": {
											"name": "heavy_rain_flag",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "heavy_rain_flag",
											"type": "Byte",
											"physicalType": "tinyint"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_export_csv",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_sql_fact_precip",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_export_csv')]",
				"[concat(variables('factoryId'), '/datasets/ds_sql_fact_precip')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_bronze_json')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_regn",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"station_id": {
						"type": "string"
					},
					"from_ts": {
						"type": "string"
					},
					"to_ts": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(formatDateTime(dataset().from_ts, 'yyyyMMdd'), '_', formatDateTime(dataset().to_ts, 'yyyyMMdd'), '.json')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat('dmi/metobs/precip/station=', dataset().station_id)",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_regn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_dmi_metobs')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_dmi_rest",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"from_ts": {
						"type": "string"
					},
					"to_ts": {
						"type": "string"
					},
					"station_id": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@concat('/v2/metObs/collections/observation/items?stationId=', dataset().station_id, '&parameterId=precip_past10min&datetime=', dataset().from_ts, '/', dataset().to_ts, '&limit=10000')",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_dmi_rest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_export_csv')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_regn",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "gold_precip_hourly.csv",
						"folderPath": "export"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "station_id",
						"type": "String"
					},
					{
						"name": "hour_start",
						"type": "String"
					},
					{
						"name": "precip_mm",
						"type": "String"
					},
					{
						"name": "max_30min_mm",
						"type": "String"
					},
					{
						"name": "heavy_rain_flag",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_regn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_sql_fact_precip')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sql_regn",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "station_id",
						"type": "varchar"
					},
					{
						"name": "hour_start",
						"type": "datetime2",
						"scale": 0
					},
					{
						"name": "precip_mm",
						"type": "decimal",
						"precision": 6,
						"scale": 2
					},
					{
						"name": "max_30min_mm",
						"type": "decimal",
						"precision": 6,
						"scale": 2
					},
					{
						"name": "heavy_rain_flag",
						"type": "tinyint",
						"precision": 3
					},
					{
						"name": "loaded_at",
						"type": "datetime2",
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "fact_precip_hourly"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_regn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_regn')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_regn_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_dmi_rest')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "DMI MetOb API",
				"annotations": [],
				"type": "RestService",
				"typeProperties": {
					"url": "[parameters('ls_dmi_rest_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_regn')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_regn_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_regn_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SystemAssignedManagedIdentity"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/tr_daily_dmi')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Started",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "pl_dmi_precip_bronze",
							"type": "PipelineReference"
						},
						"parameters": {
							"from_ts": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_from_ts')]",
							"to_ts": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_to_ts')]",
							"station_ids": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_station_ids')]"
						}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Day",
						"interval": 1,
						"startTime": "2026-09-26T16:33:00",
						"timeZone": "Romance Standard Time",
						"schedule": {
							"minutes": [
								0
							],
							"hours": [
								3
							]
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_dmi_precip_bronze')]"
			]
		}
	]
}