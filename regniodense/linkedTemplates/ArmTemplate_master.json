{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "regniodense"
		},
		"ls_adls_regn_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://regniodense.dfs.core.windows.net/"
		},
		"ls_dmi_rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://opendataapi.dmi.dk"
		},
		"ls_sql_regn_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "regniodense.database.windows.net"
		},
		"ls_sql_regn_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "regniodense-free-sql-db-3139183"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_from_ts": {
			"type": "string",
			"defaultValue": "@concat(formatDateTime(addDays(trigger().scheduledTime, -1), 'yyyy-MM-dd'), 'T00:00:00Z')"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_to_ts": {
			"type": "string",
			"defaultValue": "@concat(formatDateTime(trigger().scheduledTime, 'yyyy-MM-dd'), 'T00:00:00Z')"
		},
		"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_station_ids": {
			"type": "array",
			"defaultValue": [
				"05406",
				"05408",
				"06126"
			]
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "regniodense_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_regn_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_regn_properties_typeProperties_url')]"
					},
					"ls_dmi_rest_properties_typeProperties_url": {
						"value": "[parameters('ls_dmi_rest_properties_typeProperties_url')]"
					},
					"ls_sql_regn_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_regn_properties_typeProperties_server')]"
					},
					"ls_sql_regn_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_regn_properties_typeProperties_database')]"
					},
					"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_from_ts": {
						"value": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_from_ts')]"
					},
					"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_to_ts": {
						"value": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_to_ts')]"
					},
					"tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_station_ids": {
						"value": "[parameters('tr_daily_dmi_properties_pl_dmi_precip_bronze_parameters_station_ids')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}